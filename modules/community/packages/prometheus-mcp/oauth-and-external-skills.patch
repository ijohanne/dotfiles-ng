@@ -0,0 +1,39 @@
+package mcp
+
+import (
+	"github.com/stretchr/testify/require"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestExternalRunbookIsolationAndValidation(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(dir, "check-runekist"), 0700))
+	skill := "---\nname: check-runekist\ndescription: Investigate scheduler health.\n---\n# Scheduler health\nQuery up.\n"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "check-runekist", "SKILL.md"), []byte(skill), 0600))
+	defs, err := loadRunbookDirectory(dir)
+	require.NoError(t, err)
+	_, ok := getRunbookDef("check-runekist", defs)
+	require.True(t, ok)
+	_, ok = getRunbookDef("check-runekist")
+	require.False(t, ok)
+	index, err := buildSkillsIndex(defs)
+	require.NoError(t, err)
+	require.Contains(t, index, "check-runekist")
+	require.Contains(t, listRunbooks(defs), "check-runekist")
+	_, err = getRunbookContent("../secret", defs)
+	require.Error(t, err)
+	require.NoError(t, os.Mkdir(filepath.Join(dir, runbookDefs[0].Name), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, runbookDefs[0].Name, "SKILL.md"), []byte(runbookDefs[0].Raw), 0600))
+	_, err = loadRunbookDirectory(dir)
+	require.ErrorContains(t, err, "duplicate skill")
+}
+
+func TestEnforcedTruncation(t *testing.T) {
+	server := &ServerContainer{truncationLimit: 100, enforceTruncationLimit: true}
+	for _, limit := range []int{-1, 0, 1000} {
+		require.Equal(t, 100, server.GetEffectiveTruncationLimit(limit))
+	}
+	require.Equal(t, 20, server.GetEffectiveTruncationLimit(20))
+}
