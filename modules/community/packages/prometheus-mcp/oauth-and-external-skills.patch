diff --git i/cmd/prometheus-mcp/oauth.go w/cmd/prometheus-mcp/oauth.go
new file mode 100644
index 0000000..cf8c56c
--- /dev/null
+++ w/cmd/prometheus-mcp/oauth.go
@@ -0,0 +1,135 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/alecthomas/kingpin/v2"
+	"github.com/modelcontextprotocol/go-sdk/auth"
+	"github.com/modelcontextprotocol/go-sdk/oauthex"
+)
+
+var (
+	oauthIssuer           = kingpin.Flag("oauth.issuer", "OAuth authorization server issuer URL; enables bearer authentication.").String()
+	oauthResource         = kingpin.Flag("oauth.resource", "Canonical HTTPS identifier of this MCP resource server.").String()
+	oauthIntrospectionURL = kingpin.Flag("oauth.introspection-url", "HTTPS token introspection endpoint belonging to the issuer.").String()
+	oauthClientID         = kingpin.Flag("oauth.client-id", "OAuth resource server introspection client ID.").String()
+	oauthClientSecretFile = kingpin.Flag("oauth.client-secret-file", "File containing the introspection client secret.").String()
+	oauthScope            = kingpin.Flag("oauth.scope", "Scope required for every MCP request.").Default("prometheus.read").String()
+	runbooksDirectory     = kingpin.Flag("runbooks.directory", "Directory of additional Agent Skill directories containing SKILL.md.").String()
+)
+
+type introspectionResult struct {
+	TokenType string          `json:"token_type"`
+	Active    bool            `json:"active"`
+	Issuer    string          `json:"iss"`
+	Audience  json.RawMessage `json:"aud"`
+	Resource  json.RawMessage `json:"resource"`
+	Scope     string          `json:"scope"`
+	Subject   string          `json:"sub"`
+	Expires   int64           `json:"exp"`
+}
+
+func containsAudience(raw json.RawMessage, expected string) bool {
+	var single string
+	if json.Unmarshal(raw, &single) == nil {
+		return single == expected
+	}
+	var many []string
+	return json.Unmarshal(raw, &many) == nil && slices.Contains(many, expected)
+}
+
+func introspectionVerifier(client *http.Client, endpoint, clientID, secret, issuer, resource string) auth.TokenVerifier {
+	return func(ctx context.Context, token string, _ *http.Request) (*auth.TokenInfo, error) {
+		form := url.Values{"token": {token}, "token_type_hint": {"access_token"}}
+		req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, strings.NewReader(form.Encode()))
+		if err != nil {
+			return nil, err
+		}
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		req.SetBasicAuth(clientID, secret)
+		response, err := client.Do(req)
+		if err != nil {
+			return nil, errors.New("token introspection unavailable")
+		}
+		defer response.Body.Close()
+		if response.StatusCode != http.StatusOK {
+			return nil, auth.ErrInvalidToken
+		}
+		var result introspectionResult
+		if json.NewDecoder(io.LimitReader(response.Body, 65536)).Decode(&result) != nil {
+			return nil, auth.ErrInvalidToken
+		}
+		if !result.Active || !strings.EqualFold(result.TokenType, "Bearer") || result.Subject == "" || result.Expires <= time.Now().Unix() || (result.Issuer != "" && result.Issuer != issuer) {
+			return nil, auth.ErrInvalidToken
+		}
+		if !containsAudience(result.Audience, resource) && !containsAudience(result.Resource, resource) {
+			return nil, auth.ErrInvalidToken
+		}
+		return &auth.TokenInfo{Scopes: strings.Fields(result.Scope), Expiration: time.Unix(result.Expires, 0), UserID: result.Subject}, nil
+	}
+}
+
+func protectMCP(handler http.Handler, mux *http.ServeMux) (http.Handler, error) {
+	if *oauthIssuer == "" {
+		if *oauthResource != "" || *oauthIntrospectionURL != "" || *oauthClientID != "" || *oauthClientSecretFile != "" {
+			return nil, errors.New("incomplete OAuth configuration")
+		}
+		return handler, nil
+	}
+	for _, value := range []string{*oauthIssuer, *oauthResource, *oauthIntrospectionURL} {
+		parsed, err := url.Parse(value)
+		if err != nil || parsed.Scheme != "https" || parsed.Host == "" || parsed.User != nil || parsed.RawQuery != "" || parsed.Fragment != "" {
+			return nil, errors.New("OAuth issuer, resource, and introspection URL must be absolute HTTPS URLs")
+		}
+	}
+	if *oauthClientID == "" || *oauthScope == "" {
+		return nil, errors.New("OAuth client ID and scope are required")
+	}
+	secret, err := os.ReadFile(*oauthClientSecretFile)
+	if err != nil {
+		return nil, fmt.Errorf("read OAuth client secret: %w", err)
+	}
+	if len(strings.TrimSpace(string(secret))) == 0 {
+		return nil, errors.New("empty OAuth client secret")
+	}
+	metadataURL := strings.TrimRight(*oauthResource, "/") + "/.well-known/oauth-protected-resource"
+	metadata := auth.ProtectedResourceMetadataHandler(&oauthex.ProtectedResourceMetadata{
+		Resource: *oauthResource, AuthorizationServers: []string{*oauthIssuer}, ScopesSupported: []string{*oauthScope},
+	})
+	mux.Handle("/.well-known/oauth-protected-resource", metadata)
+	mux.Handle("/.well-known/oauth-protected-resource/mcp", metadata)
+	client := &http.Client{Timeout: 10 * time.Second, CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }}
+	verifier := introspectionVerifier(client, *oauthIntrospectionURL, *oauthClientID, strings.TrimSpace(string(secret)), *oauthIssuer, *oauthResource)
+	return authenticatedMCP(handler, verifier, metadataURL, *oauthScope), nil
+}
+
+func authenticatedMCP(handler http.Handler, verifier auth.TokenVerifier, metadataURL, scope string) http.Handler {
+	middleware := auth.RequireBearerToken(verifier, &auth.RequireBearerTokenOptions{ResourceMetadataURL: metadataURL, Scopes: []string{scope}})
+	backend := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		r = r.Clone(r.Context())
+		r.Header.Del("Authorization")
+		r.Body = http.MaxBytesReader(w, r.Body, 1024*1024)
+		handler.ServeHTTP(w, r)
+	})
+	slots := make(chan struct{}, 4)
+	return middleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case slots <- struct{}{}:
+			defer func() { <-slots }()
+			backend.ServeHTTP(w, r)
+		default:
+			w.Header().Set("Retry-After", "5")
+			http.Error(w, "MCP concurrency limit reached", http.StatusTooManyRequests)
+		}
+	}))
+}
diff --git i/cmd/prometheus-mcp/oauth_test.go w/cmd/prometheus-mcp/oauth_test.go
new file mode 100644
index 0000000..73726f7
--- /dev/null
+++ w/cmd/prometheus-mcp/oauth_test.go
@@ -0,0 +1,91 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/modelcontextprotocol/go-sdk/auth"
+	"github.com/stretchr/testify/require"
+)
+
+func TestIntrospectionVerifier(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		active   bool
+		audience string
+		scope    string
+		expires  int64
+		status   int
+	}{
+		{"valid", true, "https://metrics.example", "prometheus.read", time.Now().Add(time.Hour).Unix(), 200},
+		{"wrong audience", true, "https://other.example", "prometheus.read", time.Now().Add(time.Hour).Unix(), 401},
+		{"revoked", false, "https://metrics.example", "prometheus.read", time.Now().Add(time.Hour).Unix(), 401},
+		{"expired", true, "https://metrics.example", "prometheus.read", time.Now().Add(-time.Hour).Unix(), 401},
+		{"wrong scope", true, "https://metrics.example", "other.read", time.Now().Add(time.Hour).Unix(), 403},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			as := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				user, pass, ok := r.BasicAuth()
+				require.True(t, ok)
+				require.Equal(t, "mcp", user)
+				require.Equal(t, "secret", pass)
+				require.NoError(t, r.ParseForm())
+				require.Equal(t, "access-token", r.Form.Get("token"))
+				json.NewEncoder(w).Encode(map[string]any{"active": tc.active, "token_type": "Bearer", "aud": []string{tc.audience}, "scope": tc.scope, "sub": "ij", "exp": tc.expires, "iss": "https://auth.example"})
+			}))
+			defer as.Close()
+			verifier := introspectionVerifier(as.Client(), as.URL, "mcp", "secret", "https://auth.example", "https://metrics.example")
+			handler := auth.RequireBearerToken(verifier, &auth.RequireBearerTokenOptions{ResourceMetadataURL: "https://metrics.example/.well-known/oauth-protected-resource", Scopes: []string{"prometheus.read"}})(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200) }))
+			request := httptest.NewRequest("POST", "/mcp", nil)
+			request.Header.Set("Authorization", "Bearer access-token")
+			response := httptest.NewRecorder()
+			handler.ServeHTTP(response, request)
+			require.Equal(t, tc.status, response.Code)
+			if tc.status == 401 {
+				require.Contains(t, response.Header().Get("WWW-Authenticate"), "resource_metadata=")
+			}
+		})
+	}
+}
+
+func TestIntrospectionDoesNotFollowRedirect(t *testing.T) {
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("token leaked to redirected endpoint") }))
+	defer target.Close()
+	as := httptest.NewServer(http.RedirectHandler(target.URL, 307))
+	defer as.Close()
+	client := &http.Client{CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	verifier := introspectionVerifier(client, as.URL, "mcp", "secret", "https://auth.example", "https://metrics.example")
+	_, err := verifier(context.Background(), "access-token", httptest.NewRequest("POST", "/mcp", nil))
+	require.Error(t, err)
+}
+
+func TestAuthenticatedMCPConsumesCredentials(t *testing.T) {
+	called := false
+	backend := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		require.Empty(t, r.Header.Get("Authorization"))
+		require.Equal(t, "ij", auth.TokenInfoFromContext(r.Context()).UserID)
+		w.WriteHeader(http.StatusOK)
+	})
+	verifier := func(_ context.Context, token string, _ *http.Request) (*auth.TokenInfo, error) {
+		require.Equal(t, "access-token", token)
+		return &auth.TokenInfo{UserID: "ij", Scopes: []string{"prometheus.read"}, Expiration: time.Now().Add(time.Minute)}, nil
+	}
+	handler := authenticatedMCP(backend, verifier, "https://metrics.example/.well-known/oauth-protected-resource", "prometheus.read")
+	request := httptest.NewRequest("POST", "/mcp", nil)
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	require.Equal(t, 401, response.Code)
+	require.False(t, called)
+	require.Contains(t, response.Header().Get("WWW-Authenticate"), "resource_metadata=")
+	request.Header.Set("Authorization", "Bearer access-token")
+	response = httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	require.Equal(t, 200, response.Code)
+	require.True(t, called)
+	require.Equal(t, "Bearer access-token", request.Header.Get("Authorization"))
+}
